<!--
    Fork: Nordik Kış koyu tema. HandBrake Dark.xaml yapısı + Nordik palet
    (D:\Projects\tasarim-temalari\nordik-kis-neumorfik\TEMA.md: zemin #1E2530, açık gölge #2A3341, koyu gölge #141920).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Ui.Dark" Color="#1A2029" />
    <SolidColorBrush x:Key="Ui.Mid" Color="#222A35" />
    <SolidColorBrush x:Key="Ui.Light" Color="#2A3341" />
    <SolidColorBrush x:Key="Ui.Light2" Color="#2A3341" />
    <SolidColorBrush x:Key="Ui.Ultralight" Color="#3A4658" />
    <SolidColorBrush x:Key="Ui.UltraLight2" Color="#8A97A8" />
    <SolidColorBrush x:Key="Ui.ContrastLight" Color="#3F4D61" />
    <SolidColorBrush x:Key="Ui.WhiteSmoke" Color="#DCE3EC" />
    <SolidColorBrush x:Key="Ui.ListBoxSelect" Color="#34445A" />
    <SolidColorBrush x:Key="Ui.ToolbarHover" Color="#34445A" />
    <SolidColorBrush x:Key="Ui.Arrow" Color="#DCE3EC" />

    <SolidColorBrush x:Key="Ui.Blue" Color="#52759A" />
    <SolidColorBrush x:Key="Ui.BlueBright" Color="#83A6C2" />

    <SolidColorBrush x:Key="Ui.Background" Color="#1E2530" />
    <SolidColorBrush x:Key="Ui.BackgroundLight" Color="#B8C3D1" />
    <SolidColorBrush x:Key="Ui.BackgroundDark" Color="#0B0E13" />

    <!-- Nordik ek renkler -->
    <SolidColorBrush x:Key="Nordic.Primary" Color="#83A6C2" />
    <SolidColorBrush x:Key="Nordic.Warm" Color="#C99A72" />
    <SolidColorBrush x:Key="Nordic.Text" Color="#DCE3EC" />
    <SolidColorBrush x:Key="Nordic.Text2" Color="#8A97A8" />

    <!-- General -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E2530" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#DCE3EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#DCE3EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#83A6C2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2029" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#DCE3EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#DCE3EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7A8796" />

    <!-- Listbox -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Ui.Dark}" />
        <Setter Property="Foreground" Value="#DCE3EC" />
        <Setter Property="BorderBrush" Value="#2F3846" />
    </Style>

    <!-- Tooltip -->
    <Style x:Key="{x:Type ToolTip}" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Ui.Mid}" />
        <Setter Property="Foreground" Value="#DCE3EC" />
        <Setter Property="BorderBrush" Value="#3A4658" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <!-- StatusBar -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Ui.Mid}" />
        <Setter Property="Foreground" Value="#DCE3EC" />
    </Style>

    <!-- Text Entry Controls -->
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{DynamicResource Ui.Light}" />
        <Setter Property="Foreground" Value="#DCE3EC" />
        <Setter Property="BorderBrush" Value="#3A4658" />
        <Setter Property="CaretBrush" Value="#83A6C2" />
        <Setter Property="SelectionBrush" Value="#52759A" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Command="ApplicationCommands.Copy" />
                    <MenuItem Command="ApplicationCommands.Cut" />
                    <MenuItem Command="ApplicationCommands.Paste" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#DCE3EC"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#DCE3EC"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Tab Control: seçili sekme yüzey rengi + altta birincil çizgi -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource Ui.Mid}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource Ui.Mid}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Name="Panel" CornerRadius="8,8,0,0" Margin="0,0,2,0">
                        <Grid>
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="12,7"/>
                            <Border x:Name="Accent" Height="2" VerticalAlignment="Bottom" Margin="8,0" CornerRadius="1" Background="#83A6C2" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Panel" Property="Background" Value="{DynamicResource Ui.Mid}" />
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="Panel" Property="Background" Value="Transparent" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Panel" Property="Background" Value="#262F3C" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{DynamicResource Ui.Dark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.Ultralight}"/>
        <Setter Property="Height" Value="28" />
        <Setter Property="BorderThickness" Value="0,1,0,1"/>
    </Style>

    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#1A2029" />
            </Trigger>
            <Trigger Property="IsSelected" Value="False">
                <Setter Property="Foreground" Value="#DCE3EC" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox-->
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ComboBoxBaseStyle}">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
    </Style>

    <!-- Glyph -->
    <SolidColorBrush x:Key="ButtonGlyphBrush" Color="#B8C3D1"/>

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ComboBoxNordicDark.xaml" />
        <ResourceDictionary Source="ButtonNordicDark.xaml" />
        <ResourceDictionary Source="ContextMenuNordicDark.xaml" />
        <ResourceDictionary Source="ToolbarNordicDark.xaml" />
        <ResourceDictionary Source="GroupBoxNordicDark.xaml" />
        <ResourceDictionary Source="TreeviewNordicDark.xaml" />
        <ResourceDictionary Source="ProgressBarNordicDark.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
